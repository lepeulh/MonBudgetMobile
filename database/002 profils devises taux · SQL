-- =====================================================================
-- 002 — Devises, profils utilisateur et taux de change
-- =====================================================================
-- Trois tables :
--   devises     : liste des devises prises en charge (commune à tous)
--   profils     : paramètres de chaque utilisateur (devise, thème, ...)
--   taux_change : taux du jour, remplis automatiquement (commune à tous)
--
-- Ce script peut être relancé sans danger (il ne duplique rien).
-- =====================================================================


-- ---------------------------------------------------------------------
-- 1) DEVISES : le catalogue
-- ---------------------------------------------------------------------
create table if not exists public.devises (
  code      text primary key check (code ~ '^[A-Z]{3}$'),  -- ex. EUR, XOF
  nom       text not null,
  symbole   text not null,
  decimales smallint not null default 2 check (decimales between 0 and 4),
  actif     boolean not null default true
);

alter table public.devises enable row level security;

-- Tout utilisateur connecté peut LIRE le catalogue. Personne ne peut le
-- modifier depuis l'app (seul toi, depuis le tableau de bord Supabase).
drop policy if exists "devises_lecture" on public.devises;
create policy "devises_lecture" on public.devises
  for select to authenticated using (true);

insert into public.devises (code, nom, symbole, decimales) values
  ('EUR', 'Euro',                       '€',     2),
  ('USD', 'Dollar américain',           '$',     2),
  ('GBP', 'Livre sterling',             '£',     2),
  ('CHF', 'Franc suisse',               'CHF',   2),
  ('CAD', 'Dollar canadien',            '$ CA',  2),
  ('XOF', 'Franc CFA (BCEAO)',          'F CFA', 0),
  ('XAF', 'Franc CFA (BEAC)',           'F CFA', 0),
  ('MAD', 'Dirham marocain',            'DH',    2),
  ('TND', 'Dinar tunisien',             'DT',    3),
